# ============================================
# Environment Variables Template
# ============================================
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env to version control!
# ============================================

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: Supabase Dashboard > Project Settings > API

# Public URL (safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose to client)
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here

# Service role key (KEEP SECRET - server-side only)
# Used for admin operations, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# APPLICATION SETTINGS
# ============================================

# Admin email for supervisor privilege fallback
# Users with this email will have supervisor access regardless of role
VITE_ADMIN_EMAIL=admin@yourcompany.com

# ============================================
# RATE LIMITING (optional)
# ============================================
# Uncomment to enable rate limiting on auth endpoints
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_WINDOW_MS=60000
